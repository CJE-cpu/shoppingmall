rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == 'admin';
    }

    function isValidProduct(product) {
      return product.keys().hasAll([
          'name',
          'brand',
          'category',
          'categoryValue',
          'price',
          'discountRate',
          'stock',
          'image',
          'images',
          'description',
          'isRecommended',
          'createAt',
          'updateAt'
        ])
        && product.keys().hasOnly([
          'name',
          'brand',
          'category',
          'categoryValue',
          'price',
          'discountRate',
          'stock',
          'image',
          'images',
          'description',
          'isRecommended',
          'createAt',
          'updateAt',
          'legacyId',
          'sortOrder',
          'badge',
          'rating',
          'reviews'
        ])
        && product.name is string
        && product.brand is string
        && product.category is string
        && product.categoryValue is string
        && product.price is number
        && product.price >= 0
        && product.discountRate is number
        && product.discountRate >= 0
        && product.discountRate <= 100
        && product.stock is int
        && product.stock >= 0
        && product.image is string
        && product.images is list
        && product.description is string
        && product.isRecommended is bool
        && (!('legacyId' in product) || product.legacyId is int)
        && (!('sortOrder' in product) || product.sortOrder is int)
        && (!('badge' in product) || product.badge is string)
        && (!('rating' in product) || product.rating is number)
        && (!('reviews' in product) || product.reviews is int);
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin()
        && isValidProduct(request.resource.data)
        && request.resource.data.createAt == request.time
        && request.resource.data.updateAt == request.time;

      allow update: if (
          isAdmin()
          && isValidProduct(request.resource.data)
          && request.resource.data.createAt == resource.data.createAt
          && request.resource.data.updateAt == request.time
        )
        || (
          request.auth != null
          && isValidProduct(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock',
            'updateAt'
          ])
          && request.resource.data.createAt == resource.data.createAt
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.stock >= 0
          && request.resource.data.updateAt == request.time
        );

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'nickname',
          'role',
          'createAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.role == 'user'
        && request.resource.data.createAt == request.time;

      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname'
        ])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'items',
          'subtotal',
          'deliveryFee',
          'totalPrice',
          'createAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice
          == request.resource.data.subtotal + request.resource.data.deliveryFee
        && request.resource.data.createAt == request.time;

      allow update, delete: if false;
    }

    match /notices/{noticeId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'content',
          'authorUid',
          'createAt',
          'updateAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createAt == request.time
        && request.resource.data.updateAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'content',
          'authorUid',
          'createAt',
          'updateAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'content',
          'updateAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createAt == resource.data.createAt
        && request.resource.data.updateAt == request.time;

      allow delete: if isAdmin();
    }

    match /carts/{userId}/items/{itemId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'productId',
          'image',
          'name',
          'price',
          'quantity'
        ])
        && request.resource.data.productId == itemId
        && request.resource.data.image is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity'
        ])
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0;
    }

    match /wishlists/{userId}/items/{itemId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'productId',
          'image',
          'name',
          'price',
          'quantity',
          'createAt'
        ])
        && request.resource.data.productId == itemId
        && request.resource.data.image is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity == 1
        && request.resource.data.createAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'productId',
          'image',
          'name',
          'price',
          'quantity',
          'createAt'
        ])
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.productId == itemId
        && request.resource.data.image is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity == 1
        && request.resource.data.createAt == resource.data.createAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
